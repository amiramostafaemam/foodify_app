

# Appwrite ------------------------------------------------------------------
# Appwrite Console → your project → Settings → "API Endpoint"
EXPO_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1

# Appwrite Console → your project → Settings → "Project ID"
EXPO_PUBLIC_APPWRITE_PROJECT_ID=

# Must EXACTLY match a platform registered in
# Appwrite Console → your project → Overview → Platforms.
# (For a native/dev build this should also match app.json's bundle id.)
EXPO_PUBLIC_APPWRITE_PLATFORM=com.foodify.app

# Appwrite Console → Databases → your database → "Database ID"
EXPO_PUBLIC_APPWRITE_DATABASE_ID=

# Appwrite Console → Storage → your bucket → "Bucket ID"
EXPO_PUBLIC_APPWRITE_BUCKET_ID=

# Appwrite Console → Functions → your Stripe payment function → "Function ID"
EXPO_PUBLIC_APPWRITE_FUNCTION_PAYMENT_ID=

# Stripe ------------------------------------------------------------------
# Stripe Dashboard → Developers → API keys → "Publishable key" (pk_test_...)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Stripe's native module is not in Expo Go or web. Leave false to run there;
# the checkout falls back to "cash on delivery". Set true only for a
# development / production build so the real card payment sheet is bundled.
EXPO_PUBLIC_ENABLE_STRIPE=false
